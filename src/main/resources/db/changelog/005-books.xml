<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="005-create-books" author="hai">
        <createTable tableName="books">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="isbn" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_books_isbn"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="author_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_books_author" references="authors(id)"/>
            </column>
            <column name="category_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_books_category" references="categories(id)"/>
            </column>
            <column name="publisher" type="VARCHAR(255)"/>
            <column name="publish_year" type="VARCHAR(10)"/>
            <column name="description" type="TEXT"/>
            <column name="total_quantity" type="INT" defaultValueNumeric="1"/>
            <column name="available_quantity" type="INT" defaultValueNumeric="1"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>
    </changeSet>

</databaseChangeLog>